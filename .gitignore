# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Segredos e artefatos locais
.env
output/*
!output/.gitkeep
samples/*
!samples/.gitkeep
# Schemas registrados derivam dos seus documentos: revise antes de versionar
schemas/
# Bancos locais: histórico de execuções (com dados extraídos) e spans de telemetria
data/
.pytest_cache/
.ruff_cache/

# Nunca versionar documentos reais (notas, faturas, documentos pessoais) nem resultados
*.pdf
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.tif
*.tiff
*.heic
*.bmp

# Variações de .env (só o exemplo vai pro git)
.env.*
!.env.example
