# Chave da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Caminho do YAML de agentes (opcional)
DOC_READ_CONFIG=config/agents.yml

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO

# --- API (doc-read-api) ---------------------------------------------------------------
DOC_READ_API_HOST=127.0.0.1
DOC_READ_API_PORT=8000
# Se definida, toda rota /v1 exige o header X-API-Key (health/ready ficam abertas)
DOC_READ_API_KEY=
# Origens do frontend liberadas no CORS (vírgula ou lista JSON)
DOC_READ_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# false = não guarda os dados extraídos no histórico, só metadados (privacidade)
DOC_READ_STORE_RESULTS=true
DOC_READ_MAX_UPLOAD_MB=32
DOC_READ_CONCURRENCY=3

# --- Observabilidade (OpenTelemetry) ---------------------------------------------------
# Exportação para um backend OTLP/HTTP (collector, Grafana, Honeycomb, Datadog, Langfuse...)
# usa só as variáveis padrão do OTel. Sem endpoint, a telemetria fica só local.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20xyz
# OTEL_METRICS_EXPORTER=none
# OTEL_LOGS_EXPORTER=none
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev
# OTEL_SDK_DISABLED=true            # desliga toda a telemetria

# Spans locais que alimentam /v1/observability (governança)
DOC_READ_TELEMETRY_LOCAL=true
# Imprime os spans no console (depuração)
DOC_READ_OTEL_CONSOLE=false
# Conteúdo de prompts/respostas nos spans do SDK da Anthropic. "content" exporta dados
# pessoais dos documentos para o backend: só ligue se ele atender seus requisitos de LGPD.
ANTHROPIC_OPEN_TELEMETRY_TRACES_CONTENT_MODE=metadata_only
